# Copy this file to .env for LOCAL development only.
# On Render, set these under your service's "Environment" tab instead —
# never commit a real .env file or real secrets to git.

# ---- Firebase Admin SDK ----
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. That downloads a JSON file. Paste its ENTIRE content as a
# single-line string here (or as a Render "Secret File" — see backend/README.md).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"desimarket-4b8a5","...":"..."}

# ---- Razorpay ----
# Razorpay Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ---- ImgBB (product/shop image hosting) ----
# https://api.imgbb.com/ -> sign up (free) -> copy your API key.
# This key now lives ONLY here on the server — the frontend never sees it,
# it just sends image files to our own /api/uploads/image endpoint.
IMGBB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call this API.
# Include BOTH your GitHub Pages and Render frontend URLs since you're
# running both.
ALLOWED_ORIGINS=https://bgmi39310-bot.github.io,https://vande-market.onrender.com

# ---- Cron endpoint protection ----
# A long random string only you and your scheduled job know. Generate one
# with: python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=change-this-to-a-long-random-string

# ---- Redis (product cache + rate limiting) ----
# Optional — if left unset, the site still works exactly as before: product
# reads go straight to Firestore every time, and there's no rate limiting.
# Setting this turns both on. Free option: https://upstash.com -> create a
# Redis database -> copy its connection URL here (starts with rediss://).
REDIS_URL=rediss://default:xxxxxxxxxxxx@xxxxx.upstash.io:6379

# ---- Server ----
PORT=5000
